{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ES2024", "dom"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": ["convex/**/*.ts"],
  "exclude": ["node_modules"]
}
