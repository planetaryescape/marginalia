{
  "name": "marginalia",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "bun test scripts/deep-study && turbo run test --concurrency=1",
    "deep-study:eval": "bun scripts/deep-study/runner.ts",
    "check": "bun run lint && bun run typecheck && bun run test",
    "dev:vinext": "bun run --cwd apps/web dev:vinext",
    "build:vinext": "bun run --cwd apps/web build:vinext",
    "infra:dev": "alchemy dev --stage dev --profile default --env-file .env.local",
    "infra:plan": "alchemy plan --stage prod --profile default --env-file .env.local --no-input",
    "infra:deploy": "alchemy deploy --stage prod --profile default --env-file .env.local"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.87",
    "@biomejs/biome": "^2.3.11",
    "@effect/platform-bun": "4.1.5",
    "@effect/platform-node": "4.1.5",
    "alchemy": "2.0.0-beta.87",
    "effect": "4.1.5",
    "next": "16.4.6",
    "turbo": "^2.5.4",
    "typescript": "^5.9.3"
  },
  "patchedDependencies": {
    "css-tree@3.1.0": "patches/css-tree@3.1.0.patch"
  }
}
