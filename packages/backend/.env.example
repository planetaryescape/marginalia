# Convex CLI writes the real values to packages/backend/.env.local during setup.
CONVEX_DEPLOYMENT=dev:your-deployment
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site
# Set optional READWISE_TOKEN and VAULT_INDEXER_API_KEY on the Convex
# deployment, not in the web app. See docs/development.md.
# Before auth rollout, also set deployment-side SITE_URL to the canonical HTTPS
# frontend origin and BETTER_AUTH_SECRET to a random secret of at least 32 chars.
#
# Readers' own AI provider keys are encrypted with this deployment-side key
# (base64, 32 bytes). Generate one with: openssl rand -base64 32
# Rotating it makes every saved provider key unreadable; readers must re-save.
PROVIDER_KEYS_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
#
# Optional ChatGPT plan provider (Sign in with ChatGPT). Off unless all three
# are set. Needs OpenAI's approval of this hosted app first:
# https://openai.com/form/sign-in-with-chatgpt-interest/
# The open-source dynamic_agent_client flow needs a 127.0.0.1 callback and is
# not used here. See docs/operations.md.
# CHATGPT_PLAN_ENABLED=true
# CHATGPT_CLIENT_ID=app_replace-with-issued-client-id
# CHATGPT_REDIRECT_URI=https://reader.example.com/api/chatgpt/callback
# Only for a confidential client; sent by HTTP Basic auth, never in a body.
# CHATGPT_CLIENT_SECRET=replace-with-issued-secret
#
# Licensed Bible reading. Set on the Convex deployment, not in the web app.
# Store the actual app key in the personal family Private vault; never commit it.
# YOUVERSION_APP_KEY=op://Private/Marginalia — YouVersion API/credential
# Enable only after the app is Live and the applicable licenses are accepted.
# YOUVERSION_READING_ENABLED=true
