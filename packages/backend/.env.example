# Convex CLI writes the real values to packages/backend/.env.local during setup.
CONVEX_DEPLOYMENT=dev:your-deployment
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site
# Set OPENROUTER_API_KEY, optional READWISE_TOKEN and VAULT_INDEXER_API_KEY
# on the Convex deployment, not in the web app. See docs/development.md.
